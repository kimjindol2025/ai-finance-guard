// 대체 서비스 추천
import { call_claude, extract_json } from "./claude_client"
import { json } from "./stdlib/json"

// 특정 구독 서비스 대안 추천
fn recommend_alternatives(subscription_name, current_price) {
  println("🔍 " + subscription_name + "의 대안 서비스를 검색 중...")

  let prompt = "현재 사용 중인 서비스: " + subscription_name + "\n현재 요금: " + current_price + "원/월\n\n이 서비스의 저렴한 대안을 찾아주세요.\n\nJSON으로 응답하세요:\n{\n  \"alternatives\": [\n    {\"name\": \"서비스명\", \"price\": 월가격, \"pros\": [\"장점\"], \"cons\": [\"단점\"]},\n    ...\n  ],\n  \"recommendation\": \"추천 서비스\",\n  \"savings\": 절약가능액\n}"

  let response = call_claude(prompt)
  if (response == null) {
    println("❌ 추천 검색 실패")
    return null
  }

  try {
    let result = extract_json(response)
    return result
  } catch error {
    println("❌ JSON 파싱 오류: " + error)
    return null
  }
}

// 전체 구독 최적화 분석
fn analyze_subscriptions(subscriptions) {
  println("📊 구독 서비스 최적화 분석 중...")

  let prompt = "다음은 내가 구독 중인 서비스들입니다:\n"

  for sub in subscriptions {
    prompt = prompt + "- " + sub.name + ": " + sub.amount + "원/" + sub.cycle + "\n"
  }

  prompt = prompt + "\n비용 절감 방안과 불필요한 구독을 지적해주세요.\n추천 형식: {\"analysis\": \"분석내용\", \"recommendations\": [\"추천1\", \"추천2\", ...], \"potential_savings\": 절약액}"

  let response = call_claude(prompt)
  if (response == null) { return null }

  try {
    return extract_json(response)
  } catch error {
    println("❌ JSON 파싱 오류: " + error)
    return null
  }
}
